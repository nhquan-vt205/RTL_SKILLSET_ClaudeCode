%% module : sync_fifo
%% stage  : 2 - diagram L1 (microarchitecture)
%% source : doc/spec/sync_fifo_spec.md
%% param  : DATA_W=8, DEPTH=16, AW=4
%% open in: https://mermaid.live
flowchart LR

  %% ===== INPUT PORTS =====
  pi_clk>"clk_i [0:0]"]
  pi_rst>"rst_n_i [0:0]"]
  pi_wvld>"wr_valid_i [0:0]"]
  pi_wdat>"wr_data_i [7:0]"]
  pi_rrdy>"rd_ready_i [0:0]"]

  %% ===== OUTPUT PORTS =====
  po_wrdy(["wr_ready_o [0:0]"])
  po_rvld(["rd_valid_o [0:0]"])
  po_rdat(["rd_data_o [7:0]"])

  subgraph M_sync_fifo["sync_fifo"]
    direction LR
    n_clkrst["clk_i rising / rst_n_i async low<br/>to every register"]
    blk_hs["HANDSHAKE<br/>wr_en = wr_valid_i AND NOT full<br/>rd_en = rd_ready_i AND NOT empty"]
    reg_mem["REG ARRAY mem_q [16][7:0]<br/>write mem_q[wr_ptr_q] when wr_en<br/>no reset"]
    reg_wptr["REG wr_ptr_q [3:0]<br/>+1 when wr_en, rst = 0"]
    reg_rptr["REG rd_ptr_q [3:0]<br/>+1 when rd_en, rst = 0"]
    reg_cnt["REG count_q [4:0]<br/>+1 / −1 / hold by wr_en, rd_en<br/>rst = 0"]
    blk_flag["FLAGS<br/>full = count_q = 16<br/>empty = count_q = 0"]
    mux_rd[/"MUX16 sel=rd_ptr_q<br/>read mem_q"\]
  end

  %% ===== DATA =====
  pi_wdat -->|"wr_data_i [7:0]"| reg_mem
  reg_mem -->|"mem_q [16][7:0]"| mux_rd
  mux_rd -->|"[7:0]"| po_rdat
  reg_cnt -->|"count_q [4:0]"| blk_flag

  %% ===== CONTROL =====
  pi_wvld -.-> blk_hs
  pi_rrdy -.-> blk_hs
  blk_flag -.->|"full, empty"| blk_hs
  blk_hs -.->|"wr_en"| reg_mem
  blk_hs -.->|"wr_en"| reg_wptr
  blk_hs -.->|"rd_en"| reg_rptr
  blk_hs -.->|"wr_en, rd_en"| reg_cnt
  reg_wptr -.->|"addr"| reg_mem
  reg_rptr -.->|"sel"| mux_rd
  blk_flag -.->|"NOT full"| po_wrdy
  blk_flag -.->|"NOT empty"| po_rvld
  pi_clk -.-> n_clkrst
  pi_rst -.-> n_clkrst

  %% ===== STYLE =====
  classDef port fill:#e8eaf6,stroke:#3949ab,color:#1a237e
  classDef reg fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#3e2723
  classDef mux fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
  classDef blk fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
  classDef note fill:#fffde7,stroke:#f9a825,stroke-dasharray:4 3,color:#5d4037
  class pi_clk,pi_rst,pi_wvld,pi_wdat,pi_rrdy,po_wrdy,po_rvld,po_rdat port
  class reg_mem,reg_wptr,reg_rptr,reg_cnt reg
  class mux_rd mux
  class blk_hs,blk_flag blk
  class n_clkrst note
