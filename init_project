#!/usr/bin/env bash
# init_project - create an RTL project skeleton from RTL_SKILLSET_ClaudeCode
# in the current directory. Project name = current directory name.
set -euo pipefail

SKILLSET="${RTL_SKILLSET_DIR:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")}"
DST="$PWD"
NAME="$(basename "$DST")"
FORCE=0
DO_GIT=1

die()  { echo "init_project: ERROR: $*" >&2; exit 1; }
warn() { echo "init_project: WARN: $*" >&2; }

usage() {
    cat <<USAGE
Usage: init_project [--force] [--no-git] [-h]
  Run inside an empty directory. Project name = directory name.
  --force   allow a non-empty directory (existing files are never overwritten)
  --no-git  do not run git init / initial commit
USAGE
}

for arg in "$@"; do
    case "$arg" in
        --force)   FORCE=1 ;;
        --no-git)  DO_GIT=0 ;;
        -h|--help) usage; exit 0 ;;
        *)         usage >&2; exit 2 ;;
    esac
done

# ---- Gate --------------------------------------------------------------------
git -C "$SKILLSET" rev-parse --git-dir >/dev/null 2>&1 \
    || die "skillset is not a git repo: $SKILLSET"
[ "$DST" != "$SKILLSET" ] || die "do not run inside the skillset repo itself"
[[ "$NAME" =~ ^[A-Za-z0-9_.-]+$ ]] \
    || die "directory name '$NAME' must contain only A-Z a-z 0-9 _ . -"
if [ -n "$(ls -A "$DST")" ] && [ "$FORCE" -eq 0 ]; then
    die "directory is not empty (use --force to add only missing files)"
fi
if [ -n "$(git -C "$SKILLSET" status --porcelain)" ]; then
    warn "skillset has uncommitted changes - only the committed HEAD is copied"
fi
REV="$(git -C "$SKILLSET" rev-parse --short HEAD)"
HAD_README=0; [ -e "$DST/README.md" ] && HAD_README=1

# ---- 1. Copy committed skillset (no .git, no node_modules, no local junk) ----
git -C "$SKILLSET" archive --format=tar HEAD | tar -x --skip-old-files -C "$DST"
rm -f "$DST/init_project"

# ---- 2. Shared simulation environment (single source: S5 sim_env) -----------
mkdir -p "$DST/sim"
for f in "$DST/.claude/skills/rtl-s5-tb/references/sim_env/"*; do
    [ -e "$DST/sim/$(basename "$f")" ] || cp "$f" "$DST/sim/"
done
rm -f "$DST/sim/.gitkeep"

# ---- 3. Project directory tree ------------------------------------------------
for d in rtl tb tc sim sim/script \
         doc/spec/source doc/diagram doc/vplan \
         doc/database/input doc/database/output; do
    mkdir -p "$DST/$d"
    [ -n "$(ls -A "$DST/$d")" ] || touch "$DST/$d/.gitkeep"
done

# ---- 4. Project README (skillset README describes the skillset, not this IP) --
if [ "$HAD_README" -eq 0 ]; then
    cat > "$DST/README.md" <<README
# $NAME

RTL project initialized from RTL_SKILLSET_ClaudeCode @ \`$REV\`.

Put source documents in \`doc/spec/source/\`, then run \`/rtl-s1-spec\` in Claude Code.
Flow and rules: see \`CLAUDE.md\`.
README
fi

# ---- 5. Git -------------------------------------------------------------------
if [ "$DO_GIT" -eq 1 ] && ! git -C "$DST" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$DST" init -q -b main
    git -C "$DST" add -A
    if git -C "$DST" config user.name >/dev/null; then
        git -C "$DST" commit -q -m "init $NAME from RTL_SKILLSET_ClaudeCode@$REV"
    else
        warn "git user.name not set - files staged, no commit made"
    fi
fi

echo "init_project: '$NAME' initialized from skillset @ $REV"
echo "Next: copy source docs into doc/spec/source/, open 'claude', run /rtl-s1-spec"
