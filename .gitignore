# ============================================================================
# Allow-list: only HDL sources, simulation scripts, docs, AI skills, the AI
# instruction files (CLAUDE.md, AGENTS.md), the session template and README
# are committed. Everything else is ignored.
# ============================================================================

# 1. Project root: ignore everything ...
/*

# ... except these
!/.gitignore
!/CLAUDE.md
!/AGENTS.md
!/README*
!/init_project
!/rtl/
!/tb/
!/tc/
!/sim/
!/doc/
!/memory_bank/
!/.claude/
!/.agents/

# 2. rtl/, tb/, tc/: HDL source code only
/rtl/*
!/rtl/*.v
!/rtl/*.vh
!/rtl/*.sv
!/rtl/*.svh
/tb/*
!/tb/*.v
!/tb/*.vh
!/tb/*.sv
!/tb/*.svh
/tc/*
!/tc/*.v
!/tc/*.vh
!/tc/*.sv
!/tc/*.svh

# 3. sim/: hand-written scripts only; every Makefile / simulator output
#    (work, log, coverage, covhtmlreport, *.wlf, *.ucdb, run_test.v, ...) is ignored
/sim/*
!/sim/Makefile
!/sim/*.f
!/sim/pat.list
!/sim/*.csh
!/sim/*.tcl
!/sim/script/

# 4. doc/: generated reports
/doc/report/

# 5. memory_bank/: only the template; session summaries stay local
/memory_bank/*
!/memory_bank/session_template.md

# 6. AI folders: skills only
/.claude/*
!/.claude/skills/
/.agents/*
!/.agents/skills/

# 7. Empty-folder placeholders
!.gitkeep

# 8. Anywhere: tool / editor leftovers
node_modules/
__pycache__/
*.pyc
*~
*.swp
.DS_Store
